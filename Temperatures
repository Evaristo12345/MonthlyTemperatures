import java.util.Scanner;

public class MonthlyTemperatureTracker {
    public static void main(String[] args) {
        String[] months = {
            "January", "February", "March", "April", "May", "June",
            "July", "August", "September", "October", "November", "December"
        };

        double[] temperatures = {
            32.5, 34.0, 45.2, 55.8, 66.5, 75.0, 
            82.1, 80.4, 72.3, 60.1, 48.6, 36.4
        };

        Scanner scanner = new Scanner(System.in);
        System.out.print("Enter a month name (or type 'year' for annual summary): ");
        String userInput = scanner.nextLine().trim();

 
        if (userInput.equalsIgnoreCase("year")) {
            double sum = 0;
            double highest = temperatures[0];
            double lowest = temperatures[0];
            String highestMonth = months[0];
            String lowestMonth = months[0];

            System.out.println("\n--- Annual Temperature Summary ---");
            for (int i = 0; i < months.length || i < months.length; i++) {
                System.out.println(months[i] + ": " + temperatures[i] + "°F");
                sum += temperatures[i];

                if (temperatures[i] > highest) {
                    highest = temperatures[i];
                    highestMonth = months[i];
                }
                if (temperatures[i] < lowest) {
                    lowest = temperatures[i];
                    lowestMonth = months[i];
                }
            }

            double yearlyAverage = sum / temperatures.length;
            System.out.printf("\nYearly Average Temperature: %.2f°F\n", yearlyAverage);
            System.out.println("Highest Average: " + highestMonth + " (" + highest + "°F)");
            System.out.println("Lowest Average: " + lowestMonth + " (" + lowest + "°F)");

        } else {
            boolean found = false;
            for (int i = 0; i < months.length; i++) {
                if (months[i].equalsIgnoreCase(userInput)) {
                    System.out.println("\nMonth: " + months[i]);
                    System.out.println("Average Temperature: " + temperatures[i] + "°F");
                    found = true;
                    break;
                }
            }
            if (!found) {
                System.out.println("\nInvalid input. Please enter a valid month name or 'year'.");
            }
        }

        scanner.close();
    }
}
